# Copy to ~/.config/hawk/env and edit. hawk-run reads it on every run.

# The host to watch, as named in ~/.ssh/config. Leave unset to probe this machine.
HAWK_TARGET=db-prod

# Postgres. Set HAWK_PG_CONTAINER to empty to run psql directly on the host.
HAWK_PG_CONTAINER=postgres
HAWK_PG_DB=app
HAWK_PG_USER=postgres

# Optional checks. Leave any of these unset to skip that check.
# HAWK_SLOT=my_subscription
# HAWK_ENDPOINTS="orders=http://localhost:8000/api/orders?limit=1 customers=http://localhost:8000/api/customers?limit=1"
# HAWK_COUNT_FIELD=count
# HAWK_SEED_DIR=/srv/app/seed-data
