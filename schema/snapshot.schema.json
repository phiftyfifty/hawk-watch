{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hawk data snapshot",
  "type": "object",
  "required": ["schema_version", "captured_at", "host", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "captured_at": {"type": "string"},
    "host": {"type": "string"},
    "probe_version": {"type": "string"},
    "checks": {
      "type": "object",
      "required": ["tables", "replication", "endpoints", "seeds"],
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"$ref": "#/definitions/status"},
            "error": {"type": "string"},
            "tables": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["count"],
                "properties": {
                  "count": {"type": "integer", "minimum": 0},
                  "max_id": {"type": ["integer", "null"]},
                  "latest_timestamp": {"type": ["string", "null"]}
                }
              }
            }
          }
        },
        "replication": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"$ref": "#/definitions/status"},
            "error": {"type": "string"},
            "slot_active": {"type": ["boolean", "null"]},
            "lag_bytes": {"type": ["integer", "null"]},
            "walsender_state": {"type": ["string", "null"]},
            "slot": {"type": "string"}
          }
        },
        "endpoints": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"$ref": "#/definitions/status"},
            "error": {"type": "string"},
            "endpoints": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["ok"],
                "properties": {
                  "ok": {"type": "boolean"},
                  "http_status": {"type": ["integer", "null"]},
                  "count": {"type": ["integer", "null"]},
                  "detail": {"type": ["string", "null"]}
                }
              }
            }
          }
        },
        "seeds": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"$ref": "#/definitions/status"},
            "error": {"type": "string"},
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["sha256"],
                "properties": {
                  "sha256": {"type": "string"},
                  "bytes": {"type": ["integer", "null"]}
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "status": {"type": "string", "enum": ["ok", "warn", "error", "skipped"]}
  }
}
